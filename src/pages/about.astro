---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "About Simon Ganz";
const description = "Simon Ganz is a television writer living in Los Angeles. He designs the occasional web or tech project in his spare time.";
---

<BaseLayout title={title} description={description}>
    <p>
        Simon Ganz is a television writer living in Los Angeles. He designs the occasional web or tech project in his spare time and hosts <a href="https://www.huffpost.com/entry/ivfml-podcast_n_592dc2cae4b055a197cda587">IVFML</a>, a Huff Post podcast about infertility.
    </p>

    <hr />
</BaseLayout>
