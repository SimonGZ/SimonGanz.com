---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths({ paginate }) {
    const posts = (await getCollection('blog')).sort(
        (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
    );
    return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const title = "Simon Ganz";
const description = "Personal blog of Simon Ganz, covering topics such as screenwriting, comedy, and technology.";
---

<BaseLayout title={title} description={description}>
    {page.data.map(async (post, index) => {
        const { Content } = await render(post);
        const isLast = index === page.data.length - 1;
        
        return (
            <article>
                <header>
                    <h1>
                        <a href={`/${post.data.date.toISOString().slice(0, 4)}/${post.data.date.toISOString().slice(5, 7)}/${post.id}/`} title={post.data.title}>{post.data.title}</a>
                    </h1>
                    <div class='postDate'>
                        <a href={`/${post.data.date.toISOString().slice(0, 4)}/${post.data.date.toISOString().slice(5, 7)}/${post.id}/`} title='Permalink'>
                            <small>
                                {post.data.date.toLocaleDateString('en-US', {
                                    year: 'numeric',
                                    month: 'short',
                                    day: 'numeric',
                                })}
                            </small>
                        </a>
                    </div>
                </header>
                
                <Content />
                
                {!isLast && <hr class='postDivider'>}
            </article>
        );
    })}
    
    <div class="pagination-wrapper">
        <div class="pagination-controls">
            {page.url.prev && <a href={page.url.prev}>Newer Posts</a>}
            {page.url.prev && page.url.next && <span class="separator">•</span>}
            {page.url.next && <a href={page.url.next}>Older Posts</a>}
        </div>
    </div>
</BaseLayout>

<style>
    .pagination-wrapper {
        text-align: center;
        margin-top: 2em; /* Increased spacing as requested */
        margin-bottom: 3em;
        padding-top: 2em;
        border-top: 3px solid rgb(37,37,37); /* Darker color for visibility */
        width: 100%;
        display: block;
    }
    
    .pagination-controls {
        display: inline-block;
        font-family: Helvetica, sans-serif;
        font-size: 18px;
    }
    
    .pagination-controls a {
        color: #999;
        font-weight: 300;
        text-decoration: none;
        margin: 0 10px;
    }

    .pagination-controls a:hover {
        color: #ff3333;
        text-decoration: underline;
    }
    
    .separator {
        color: #ccc;
    }
</style>
